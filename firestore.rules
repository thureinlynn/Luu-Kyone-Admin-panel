rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'thureinlynn.mm@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (!('isSuspended' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuspended != true)
        && (!('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'Suspended')
      );
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOptionalDateOrTimestamp(data, key) {
      return !(key in data)
        || data[key] is timestamp
        || (data[key] is string && data[key].size() <= 64);
    }

    // Entity Validation Helpers (Eight Pillars: Strict Keys, Types & Bounds)
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'name', 'photoURL', 'avatarUrl',
          'handle', 'phone', 'role', 'isVerified', 'verificationStatus',
          'accountStatus', 'isSuspended', 'joinedAt', 'nationality',
          'passportLast4', 'kycSubmittedAt', 'kycNotes', 'warningsCount',
          'createdAt', 'updatedAt'
        ])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && (
          ('displayName' in data && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120)
          || ('name' in data && data.name is string && data.name.size() > 0 && data.name.size() <= 120)
        )
        && data.role in ['admin', 'traveler', 'sender']
        && (!('isVerified' in data) || data.isVerified is bool)
        && isValidOptionalString(data, 'uid', 128)
        && isValidOptionalString(data, 'name', 120)
        && isValidOptionalString(data, 'displayName', 120)
        && isValidOptionalString(data, 'photoURL', 512)
        && isValidOptionalString(data, 'avatarUrl', 512)
        && isValidOptionalString(data, 'handle', 64)
        && isValidOptionalString(data, 'phone', 40)
        && isValidOptionalString(data, 'joinedAt', 64)
        && isValidOptionalString(data, 'nationality', 80)
        && isValidOptionalString(data, 'passportLast4', 8)
        && isValidOptionalString(data, 'kycSubmittedAt', 64)
        && isValidOptionalString(data, 'kycNotes', 500)
        && (!('verificationStatus' in data) || data.verificationStatus in ['Verified', 'Pending', 'Unverified'])
        && (!('accountStatus' in data) || data.accountStatus in ['Active', 'Suspended'])
        && (!('isSuspended' in data) || data.isSuspended is bool)
        && (!('warningsCount' in data) || (data.warningsCount is number && data.warningsCount >= 0 && data.warningsCount <= 1000))
        && isValidOptionalDateOrTimestamp(data, 'createdAt')
        && isValidOptionalDateOrTimestamp(data, 'updatedAt');
    }

    function isValidTrip(data) {
      return data.keys().hasAll([
          'origin', 'destination', 'departureDate', 'weightKg',
          'pricePerKg', 'status', 'travelerId', 'travelerName'
        ])
        && data.keys().hasOnly([
          'id', 'tripCode', 'travelerId', 'userId', 'travelerName',
          'travelerAvatarUrl', 'travelerVerified', 'traveler',
          'origin', 'originCity', 'departureCity', 'originCountry',
          'departureCountry', 'originCode', 'destination', 'destinationCity',
          'arrivalCity', 'destinationCountry', 'arrivalCountry', 'destinationCode',
          'departureDate', 'lastDropOffDate', 'arrivalDate', 'checkOutDate',
          'completedDate', 'weightKg', 'availableWeightKg', 'weightCapacityKg',
          'weightAvailableKg', 'carriedWeightKg', 'pricePerKg', 'pricePerKgUsd',
          'feePerKg', 'serviceFeeType', 'feeDescription',
          'departureHandoverSpot', 'dropOffLocationNote', 'destinationPickupSpot',
          'pickUpLocationNote', 'acceptedCategories', 'acceptedItems',
          'prohibitedItems', 'status', 'notes', 'announcement',
          'contactChannels', 'contacts', 'createdAt', 'updatedAt'
        ])
        && data.origin is string && data.origin.size() > 0 && data.origin.size() <= 120
        && data.destination is string && data.destination.size() > 0 && data.destination.size() <= 120
        && data.departureDate is string && data.departureDate.size() > 0 && data.departureDate.size() <= 32
        && data.weightKg is number && data.weightKg > 0 && data.weightKg <= 200
        && data.pricePerKg is number && data.pricePerKg >= 0 && data.pricePerKg <= 10000
        && data.status in ['Active', 'Completed', 'Cancelled', 'active', 'completed', 'cancelled']
        && data.travelerId is string && isValidId(data.travelerId)
        && data.travelerName is string && data.travelerName.size() > 0 && data.travelerName.size() <= 120
        && isValidOptionalString(data, 'id', 128)
        && isValidOptionalString(data, 'userId', 128)
        && isValidOptionalString(data, 'tripCode', 24)
        && isValidOptionalString(data, 'originCity', 100)
        && isValidOptionalString(data, 'departureCity', 100)
        && isValidOptionalString(data, 'originCountry', 100)
        && isValidOptionalString(data, 'departureCountry', 100)
        && isValidOptionalString(data, 'originCode', 10)
        && isValidOptionalString(data, 'destinationCity', 100)
        && isValidOptionalString(data, 'arrivalCity', 100)
        && isValidOptionalString(data, 'destinationCountry', 100)
        && isValidOptionalString(data, 'arrivalCountry', 100)
        && isValidOptionalString(data, 'destinationCode', 10)
        && isValidOptionalString(data, 'arrivalDate', 32)
        && isValidOptionalString(data, 'lastDropOffDate', 32)
        && isValidOptionalString(data, 'checkOutDate', 32)
        && isValidOptionalString(data, 'completedDate', 32)
        && isValidOptionalString(data, 'travelerAvatarUrl', 512)
        && isValidOptionalString(data, 'departureHandoverSpot', 200)
        && isValidOptionalString(data, 'dropOffLocationNote', 200)
        && isValidOptionalString(data, 'destinationPickupSpot', 200)
        && isValidOptionalString(data, 'pickUpLocationNote', 200)
        && isValidOptionalString(data, 'notes', 2000)
        && isValidOptionalString(data, 'announcement', 2000)
        && isValidOptionalString(data, 'feeDescription', 160)
        && isValidOptionalString(data, 'serviceFeeType', 20)
        && (!('travelerVerified' in data) || data.travelerVerified is bool)
        && (!('traveler' in data) || data.traveler is map)
        && (!('contactChannels' in data) || data.contactChannels is map)
        && (!('contacts' in data) || data.contacts is map)
        && (!('availableWeightKg' in data) || (data.availableWeightKg is number && data.availableWeightKg >= 0 && data.availableWeightKg <= 200))
        && (!('weightCapacityKg' in data) || (data.weightCapacityKg is number && data.weightCapacityKg >= 0 && data.weightCapacityKg <= 200))
        && (!('weightAvailableKg' in data) || (data.weightAvailableKg is number && data.weightAvailableKg >= 0 && data.weightAvailableKg <= 200))
        && (!('carriedWeightKg' in data) || (data.carriedWeightKg is number && data.carriedWeightKg >= 0 && data.carriedWeightKg <= 200))
        && (!('pricePerKgUsd' in data) || (data.pricePerKgUsd is number && data.pricePerKgUsd >= 0 && data.pricePerKgUsd <= 10000))
        && (!('feePerKg' in data) || (data.feePerKg is number && data.feePerKg >= 0 && data.feePerKg <= 10000))
        && (!('acceptedCategories' in data) || (data.acceptedCategories is list && data.acceptedCategories.size() <= 16))
        && (!('acceptedItems' in data) || (data.acceptedItems is list && data.acceptedItems.size() <= 16))
        && (!('prohibitedItems' in data) || (data.prohibitedItems is list && data.prohibitedItems.size() <= 16))
        && isValidOptionalDateOrTimestamp(data, 'createdAt')
        && isValidOptionalDateOrTimestamp(data, 'updatedAt');
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'corridor', 'severity', 'isActive', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['title', 'message', 'corridor', 'severity', 'isActive', 'createdAt', 'createdBy', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.corridor is string && data.corridor.size() > 0 && data.corridor.size() <= 120
        && data.severity in ['Info', 'Warning', 'Critical']
        && data.isActive is bool
        && isValidOptionalDateOrTimestamp(data, 'createdAt')
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 120
        && isValidOptionalDateOrTimestamp(data, 'updatedAt');
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorName', 'actorRole', 'action', 'target', 'timestamp', 'category'])
        && data.keys().hasOnly(['actorName', 'actorEmail', 'actorRole', 'action', 'target', 'timestamp', 'category', 'createdAt'])
        && data.actorName is string && data.actorName.size() > 0 && data.actorName.size() <= 120
        && data.actorRole is string && data.actorRole.size() > 0 && data.actorRole.size() <= 40
        && data.action is string && data.action.size() > 0 && data.action.size() <= 200
        && data.target is string && data.target.size() > 0 && data.target.size() <= 400
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64
        && data.category in ['trip', 'user', 'moderation', 'announcement', 'auth', 'admin', 'settings']
        && isValidOptionalString(data, 'actorEmail', 254)
        && isValidOptionalDateOrTimestamp(data, 'createdAt');
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['platformName', 'supportEmail', 'defaultPageSize', 'maxLuggageWeightKg'])
        && data.keys().hasOnly([
          'platformName', 'supportEmail', 'defaultPageSize', 'maxLuggageWeightKg',
          'requireKycForTrips', 'autoFlagHighWeightKg', 'highWeightThresholdKg',
          'maintenanceMode', 'emailAlertsFlagged', 'emailAlertsPendingKyc',
          'sessionTimeoutMinutes', 'updatedAt', 'updatedBy', 'updatedAtServer'
        ])
        && data.platformName is string && data.platformName.size() > 0 && data.platformName.size() <= 100
        && data.supportEmail is string && data.supportEmail.size() > 0 && data.supportEmail.size() <= 254
        && data.defaultPageSize in [10, 20, 50]
        && data.maxLuggageWeightKg is number && data.maxLuggageWeightKg >= 5 && data.maxLuggageWeightKg <= 200
        && (!('requireKycForTrips' in data) || data.requireKycForTrips is bool)
        && (!('autoFlagHighWeightKg' in data) || data.autoFlagHighWeightKg is bool)
        && (!('highWeightThresholdKg' in data) || (data.highWeightThresholdKg is number && data.highWeightThresholdKg >= 1 && data.highWeightThresholdKg <= 200))
        && (!('maintenanceMode' in data) || data.maintenanceMode is bool)
        && (!('emailAlertsFlagged' in data) || data.emailAlertsFlagged is bool)
        && (!('emailAlertsPendingKyc' in data) || data.emailAlertsPendingKyc is bool)
        && (!('sessionTimeoutMinutes' in data) || data.sessionTimeoutMinutes in [30, 60, 120, 480])
        && isValidOptionalString(data, 'updatedAt', 64)
        && isValidOptionalString(data, 'updatedBy', 120)
        && isValidOptionalDateOrTimestamp(data, 'updatedAtServer');
    }

    // Users Collection (PII protected)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          isOwner(userId)
          && incoming().role != 'admin'
          && (!('isVerified' in incoming()) || incoming().isVerified == false)
          && (!('verificationStatus' in incoming()) || incoming().verificationStatus != 'Verified')
        )
      );
      allow update: if isValidId(userId) && isValidUser(incoming())
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().role == existing().role
            && (!('isVerified' in existing()) || incoming().isVerified == existing().isVerified)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'name', 'photoURL', 'avatarUrl', 'phone', 'handle', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Trips Collection
    match /trips/{tripId} {
      allow get: if isValidId(tripId) && isSignedIn() && (
        isAdmin()
        || existing().status in ['Active', 'active']
        || existing().travelerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        existing().status in ['Active', 'active']
        || existing().travelerId == request.auth.uid
        || isAdmin()
      );
      allow create: if isValidId(tripId) && isSignedIn() && isValidTrip(incoming()) && (
        isAdmin() || incoming().travelerId == request.auth.uid
      );
      allow update: if isValidId(tripId) && isSignedIn() && isValidTrip(incoming())
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && (
          isAdmin() || (
            existing().travelerId == request.auth.uid
            && !(existing().status in ['Completed', 'completed', 'Cancelled', 'cancelled'])
            && incoming().travelerId == existing().travelerId
            && incoming().diff(existing()).affectedKeys().hasOnly(['departureDate', 'arrivalDate', 'weightKg', 'availableWeightKg', 'notes', 'announcement', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(tripId) && isSignedIn() && (
        isAdmin() || existing().travelerId == request.auth.uid
      );
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn() && (existing().isActive == true || isAdmin());
      allow list: if isSignedIn() && (existing().isActive == true || isAdmin());
      allow create: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
      allow update: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming())
        && incoming().createdBy == existing().createdBy
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    // Audit Logs Collection (Append-only by Admins)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(settingId) && isAdmin() && isValidSettings(incoming());
      allow delete: if false;
    }

    // Connection Probe Path
    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
